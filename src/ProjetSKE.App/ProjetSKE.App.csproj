<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Une seule appli, deux cibles : Android (téléphone) et Windows (PC). Tout le code est commun :
      une fonctionnalité ajoutée l'est forcément sur les deux (voir CLAUDE.md). La cible Windows ne se
      compile que sur Windows (GitHub Actions, windows-latest).
    -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>ProjetSKE.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Projet SKE</ApplicationTitle>
    <ApplicationId>com.laizu.projetske</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <!-- Produire un .apk installable directement (et non un .aab pour le Play Store). -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <!--
    Téléphone : seulement les processeurs utiles. arm64 = presque tous les téléphones depuis 2017 ; x64 = l'émulateur
    du test automatique. Sans les vieux arm 32 bits et x86, l'APK est bien plus léger (mises à jour plus rapides).
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- PC (Windows) : appli autonome, sans installateur (un dossier avec ProjetSKE.App.exe, dans un .zip). -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Numéro de compilation lisible par l'appli (mises à jour), identique sur téléphone et sur PC. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SkeBuild</_Parameter1>
      <_Parameter2>$(ApplicationVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Signature unique de l'APK : toutes les versions sont signées avec la même clé (signing/projetske.keystore),
    sinon Android refuse d'installer une mise à jour par-dessus l'ancienne.
    Le mot de passe n'est PAS dans le code : GitHub Actions le passe depuis le secret SKE_KEYSTORE_PASS
    (-p:SkeKeystorePass=...). Sans mot de passe (compilation locale), l'APK est signé avec la clé de débogage.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(SkeKeystorePass)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)../../signing/projetske.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>projetske</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>$(SkeKeystorePass)</AndroidSigningStorePass>
    <AndroidSigningKeyPass>$(SkeKeystorePass)</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#1C1917" />
    <MauiFont Include="Resources\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProjetSKE.Core\ProjetSKE.Core.csproj" />
  </ItemGroup>

</Project>
