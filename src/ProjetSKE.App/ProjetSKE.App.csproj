<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>ProjetSKE.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Projet SKE</ApplicationTitle>
    <ApplicationId>com.laizu.projetske</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <!-- Produire un .apk installable directement (et non un .aab pour le Play Store). -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <!--
    Signature unique de l'APK : toutes les versions sont signées avec la même clé (signing/projetske.keystore),
    sinon Android refuse d'installer une mise à jour par-dessus l'ancienne.
    Le mot de passe n'est PAS dans le code : GitHub Actions le passe depuis le secret SKE_KEYSTORE_PASS
    (-p:SkeKeystorePass=...). Sans mot de passe (compilation locale), l'APK est signé avec la clé de débogage.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(SkeKeystorePass)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)../../signing/projetske.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>projetske</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>$(SkeKeystorePass)</AndroidSigningStorePass>
    <AndroidSigningKeyPass>$(SkeKeystorePass)</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#1C1917" />
    <MauiFont Include="Resources\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProjetSKE.Core\ProjetSKE.Core.csproj" />
  </ItemGroup>

</Project>
